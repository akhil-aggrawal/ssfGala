# Copy to .env.local and fill in. Never commit real values.
# Names come from the Architecture Design doc ("Deployment and observability").

# Supabase project URL and anon key (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key: server only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key and webhook signing secret: server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth provider, read by supabase/config.toml for local sign-in.
# Hosted projects set these in the Supabase dashboard: Auth > Providers > Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Resend API key for transactional email: server only
RESEND_API_KEY=

# App base URL for links and redirects, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Sentry DSN for server error reports: optional, nothing is sent when unset
SENTRY_DSN=
# Sender for every email; onboarding@resend.dev until a domain is verified
EMAIL_FROM=
# Set to memory in tests to keep emails in an in-memory outbox instead of Resend
EMAIL_TRANSPORT=
