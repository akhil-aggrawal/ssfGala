.claude/super-board/active
.claude/super-board/onboard-answers.json
.claude/super-board/onboard-staged/
.claude/super-board/backup/
.claude/super-board/inflight/
.claude/super-board/migrations/
.claude/super-board/upgrade.json
.claude/super-board/perm-rules.txt
.claude/settings.json.bak-*

# Local env files: secrets stay on this machine
.env
.env*.local

# Python bytecode from super-board scripts
__pycache__/

# Supabase CLI local state
supabase/.branches
supabase/.temp

# Machine-specific npm registry (e.g. a corporate proxy)
.npmrc

# super-board local run logs; the run manifest (.md) is committed
docs/super-board/runs/*.log
docs/super-board/runs/*-workers/

# Local Isaac tool state
.isaac/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo
/coverage
