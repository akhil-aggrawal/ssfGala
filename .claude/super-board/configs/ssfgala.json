{
  "version": 1,
  "description": "SSF Gala website build pipeline",
  "project": {
    "owner": "akhil-aggrawal",
    "title": "SsfGala build board",
    "number": 5
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/akhil-aggrawal/ssfGala"
  },
  "base_branch": "staging",
  "timezone": "America/Los_Angeles",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 4000,
    "always_human": {
      "money": {
        "labels": [
          "money",
          "payments",
          "billing",
          "pricing"
        ],
        "paths": [
          "**/billing/**",
          "**/payments/**",
          "**/stripe/**",
          "**/checkout/**"
        ],
        "keywords": [
          "stripe.",
          "payment_intent",
          "price_id",
          "invoice.create"
        ]
      },
      "auth": {
        "labels": [
          "auth",
          "security"
        ],
        "paths": [
          "**/auth/**",
          "**/authz/**",
          "**/permissions/**"
        ],
        "keywords": [
          "jwt.sign",
          "bcrypt",
          "password_hash",
          "service_role"
        ]
      },
      "schema": {
        "labels": [
          "schema",
          "destructive"
        ],
        "paths": [],
        "keywords": [
          "drop table",
          "drop column",
          "truncate table",
          "rename column",
          "drop schema"
        ]
      }
    },
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [
      "supabase/migrations/**",
      "prisma/migrations/**",
      "drizzle/**",
      "**/migrations/*.sql",
      "db/migrate/**",
      "alembic/versions/**"
    ],
    "allowed_envs": [
      "test",
      "staging"
    ],
    "target_env": "staging",
    "commands": {
      "staging": "supabase db push --yes --db-url \"${STAGING_DB_URL:-$(set -a; . /Users/akhil/myapps/ssfGala/.env; printf %s \"$STAGING_DB_URL\")}\""
    },
    "checks": {
      "staging": "supabase migration list --db-url \"${STAGING_DB_URL:-$(set -a; . /Users/akhil/myapps/ssfGala/.env; printf %s \"$STAGING_DB_URL\")}\""
    },
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [
    "npm ci --silent && npm run verify",
    ".claude/bin/super-board-local-db.sh scratch -- sh -c 'supabase db reset --db-url \"$SB_SCRATCH_DB_URL\" --yes'"
  ],
  "max_workers": 1,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": [
      "sentry",
      "github",
      "architecture"
    ],
    "window_days": 14,
    "architecture": {
      "max_findings": 5
    },
    "custom": [],
    "sentry": {
      "org": "small-steps-foundation",
      "project": "ssf-gala",
      "host": "https://sentry.io",
      "environment": "",
      "min_events": 1,
      "min_users": 1
    }
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "akhil-aggrawal"
  }
}
